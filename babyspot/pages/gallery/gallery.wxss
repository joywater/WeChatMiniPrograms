.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding-top: 14px;
}

.card {
  width: 31%;
  margin-right: 3.5%;
  margin-bottom: 13px;
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 14rpx 14rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(120, 90, 60, 0.08);
}

/* 每行第 3 个去掉右边距 */
.card-end {
  margin-right: 0;
}

.card-img-wrap {
  width: 100%;
  height: 180rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.card-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.card-emoji {
  font-size: 96rpx;
  line-height: 1.1;
}

.card-label {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #4A3B32;
}

.empty {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-emoji {
  font-size: 100rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #A08A78;
}

.credit {
  margin-top: 20rpx;
  padding-bottom: 20rpx;
  text-align: center;
}

.credit-text {
  font-size: 20rpx;
  color: #C4B3A4;
}
